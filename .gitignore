# Secrets - only .env.example is committed
.env
.env.*
!.env.example

# Everything under data/ is local: raw pulls, normalized ads, LLM batches, media (Platform
# Data, retention-limited) plus guard state and run ledgers. Only the placeholder is tracked.
data/*
!data/.gitkeep

# Generated reports are Platform Data too; keep them local
reports/*/

# Handoff briefs may carry real competitor copy; local only
handoff/*
!handoff/.gitkeep

# launchd output and guard logs
logs/

# Python / tooling caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
